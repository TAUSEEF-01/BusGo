{
  "expo": {
    "name": "BusGo",
    "slug": "busgo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "busgo",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "package": "com.busgo.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dc2626"
      }
    },
    "ios": {
      "bundleIdentifier": "com.busgo.mobile",
      "buildNumber": "1"
    },
    "extra": {
      "kongPort": 18085
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#dc2626"
        }
      ]
    ]
  }
}
